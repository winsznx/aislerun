# Local development. Copy to .env and fill in the three blank values. Never commit .env.

# Any password; docker compose creates the database with it. Use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://aislerun:<POSTGRES_PASSWORD>@127.0.0.1:55432/aislerun

# 32+ random characters, e.g. `openssl rand -hex 32`. Signs read tokens and evidence links.
REPORT_TOKEN_SECRET=

# An EVM address you control. Paid inspections send USDC here. Nothing is paid in a local run.
PAYMENT_RECEIVER=

# Where this API and the web app are reachable. PayBox must be able to reach SERVICE_BASE_URL
# for a paid run, so use a public HTTPS URL (tunnel or host) only when you test real payments.
SERVICE_BASE_URL=http://localhost:8790
WEB_BASE_URL=http://localhost:3100
PORT=8790

X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://facilitator.payai.network
INSPECTION_PRICE_USD=0.05
FIXTURE_ORIGIN=https://aislerun-fixtures.vercel.app
EVIDENCE_DIR=./.evidence
BUILD_VERSION=dev
# Optional: comma-separated role:inspection-id pairs to publish, e.g. failed:<id>,retest:<id>
DEMO_RUNS=
